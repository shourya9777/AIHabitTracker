<button id="ai-chat-toggle" class="fixed bottom-20 md:bottom-6 right-6 z-40 w-14 h-14 rounded-full bg-gradient-to-br from-brand-500 to-brand-700 text-white shadow-2xl shadow-brand-500/40 flex items-center justify-center hover:scale-105 active:scale-95 transition" aria-label="AI Chat">
  <i data-lucide="message-circle" id="ai-chat-toggle-icon" class="w-[22px] h-[22px]"></i>
</button>

<div id="ai-chat-panel" class="hidden fixed bottom-36 md:bottom-24 right-6 z-40 w-[min(92vw,380px)] h-[min(70vh,520px)] glass-strong rounded-2xl flex flex-col animate-slide-up shadow-2xl overflow-hidden">
  <div class="px-4 py-3 border-b divider flex items-center gap-2">
    <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-brand-500 to-brand-700 text-white flex items-center justify-center shadow-md shadow-brand-500/30">
      <i data-lucide="sparkles" class="w-[14px] h-[14px]"></i>
    </div>
    <div>
      <div class="text-sm font-medium">Habit Analysis</div>
      <div class="text-xs text-muted">AI-powered insights</div>
    </div>
  </div>

  <div id="ai-chat-messages" class="flex-1 overflow-y-auto px-4 py-3 space-y-3"></div>

  <form id="ai-chat-form" class="p-3 border-t divider flex gap-2">
    <input id="ai-chat-input" class="input" placeholder="Ask about your habits..." />
    <button type="submit" id="ai-chat-send" class="btn-primary px-3">
      <i data-lucide="send" class="w-4 h-4"></i>
    </button>
  </form>
</div>
