<div data-modal="habit-form" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/30 dark:bg-black/60 backdrop-blur-md animate-fade-in">
  <div class="max-w-lg w-full max-h-[90vh] glass-strong rounded-2xl animate-slide-up shadow-2xl flex flex-col overflow-hidden">
    <div class="flex items-center justify-between px-6 pt-6 pb-3 shrink-0">
      <h3 class="text-lg font-semibold" id="habit-form-title">New habit</h3>
      <button class="btn-ghost p-2" data-modal-close aria-label="Close">
        <i data-lucide="x" class="w-[18px] h-[18px]"></i>
      </button>
    </div>
    <div class="px-6 pb-6 overflow-y-auto flex-1 min-h-0">
      <form id="habit-form" class="space-y-4">
        <input type="hidden" id="habit-id" />

        <div>
          <label class="label">Habit name</label>
          <input id="habit-name" class="input" placeholder="e.g. Drink 2L of water" required autofocus />
        </div>

        <div>
          <label class="label">Description</label>
          <textarea id="habit-description" class="input resize-none" rows="2" placeholder="Why does this habit matter to you?"></textarea>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="label">Category</label>
            <select id="habit-category" class="input"></select>
          </div>
          <div>
            <label class="label">Frequency</label>
            <select id="habit-frequency" class="input">
              <option value="daily">Daily</option>
              <option value="weekly">Weekly</option>
            </select>
          </div>
        </div>

        <div>
          <label class="label">
            Target days per week: <span class="font-semibold" id="habit-target-value">7</span>
          </label>
          <input type="range" id="habit-target" min="1" max="7" value="7" class="w-full accent-brand-600" />
        </div>

        <div>
          <label class="label">Icon</label>
          <div id="habit-icon-picker" class="flex flex-wrap gap-2"></div>
        </div>

        <div>
          <label class="label">Color</label>
          <div id="habit-color-picker" class="flex gap-2"></div>
        </div>

        <div class="flex justify-end gap-2 pt-2">
          <button type="button" class="btn-secondary" data-modal-close>Cancel</button>
          <button type="submit" id="habit-form-submit" class="btn-primary">Create habit</button>
        </div>
      </form>
    </div>
  </div>
</div>

<div data-modal="delete-habit" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/30 dark:bg-black/60 backdrop-blur-md animate-fade-in">
  <div class="max-w-sm w-full max-h-[90vh] glass-strong rounded-2xl animate-slide-up shadow-2xl flex flex-col overflow-hidden">
    <div class="flex items-center justify-between px-6 pt-6 pb-3 shrink-0">
      <h3 class="text-lg font-semibold">Delete habit?</h3>
      <button class="btn-ghost p-2" data-modal-close aria-label="Close">
        <i data-lucide="x" class="w-[18px] h-[18px]"></i>
      </button>
    </div>
    <div class="px-6 pb-6">
      <p class="text-sm text-soft">
        This will permanently delete <b id="delete-habit-name"></b> and all its history. This can't be undone.
      </p>
      <div class="flex justify-end gap-2 mt-5">
        <button class="btn-secondary" data-modal-close>Cancel</button>
        <button id="delete-habit-confirm" class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-br from-rose-500 to-red-600 px-4 py-2.5 text-sm font-medium text-white hover:brightness-110 shadow-lg shadow-rose-500/30 transition">
          Delete
        </button>
      </div>
    </div>
  </div>
</div>
