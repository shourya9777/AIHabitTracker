<div data-modal="settings" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/30 dark:bg-black/60 backdrop-blur-md animate-fade-in">
  <div class="max-w-lg w-full max-h-[90vh] glass-strong rounded-2xl animate-slide-up shadow-2xl flex flex-col overflow-hidden">
    <div class="flex items-center justify-between px-6 pt-6 pb-3 shrink-0">
      <h3 class="text-lg font-semibold">Settings</h3>
      <button class="btn-ghost p-2" data-modal-close aria-label="Close">
        <i data-lucide="x" class="w-[18px] h-[18px]"></i>
      </button>
    </div>
    <div class="px-6 pb-6 overflow-y-auto flex-1 min-h-0">
      <div class="space-y-4">
        <div>
          <label class="label">Display name</label>
          <input id="settings-name" class="input" />
        </div>

        <label class="flex items-start gap-3 p-3 rounded-xl glass cursor-pointer hover:bg-[var(--surface-hover)]">
          <input id="settings-morning" type="checkbox" class="mt-1 accent-brand-600" />
          <div>
            <div class="text-sm font-medium">Morning motivation</div>
            <div class="text-xs text-faint">
              Show a short personalised AI message every morning on the dashboard.
            </div>
          </div>
        </label>

        <div class="flex justify-end gap-2 pt-2">
          <button class="btn-secondary" data-modal-close>Cancel</button>
          <button id="settings-save-btn" class="btn-primary">Save</button>
        </div>
      </div>
    </div>
  </div>
</div>
