<div data-modal="suggest-habit" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/30 dark:bg-black/60 backdrop-blur-md animate-fade-in">
  <div class="max-w-xl w-full max-h-[90vh] glass-strong rounded-2xl animate-slide-up shadow-2xl flex flex-col overflow-hidden">
    <div class="flex items-center justify-between px-6 pt-6 pb-3 shrink-0">
      <h3 class="text-lg font-semibold">AI Habit Suggestions</h3>
      <button class="btn-ghost p-2" id="suggest-close-btn" aria-label="Close">
        <i data-lucide="x" class="w-[18px] h-[18px]"></i>
      </button>
    </div>
    <div class="px-6 pb-6 overflow-y-auto flex-1 min-h-0">

      <div data-suggest-step="0" class="space-y-4">
        <div class="text-sm text-soft">Answer 3 quick questions and I'll suggest 3 personalised habits.</div>
        <div>
          <label class="label">What are your goals right now?</label>
          <textarea id="suggest-goals" class="input resize-none" rows="3" placeholder="e.g. Get fitter, read more, reduce phone time..." autofocus></textarea>
        </div>
        <div class="flex justify-end gap-2">
          <button class="btn-secondary" data-suggest-cancel>Cancel</button>
          <button class="btn-primary" data-suggest-next="1">Next</button>
        </div>
      </div>

      <div data-suggest-step="1" class="space-y-4 hidden">
        <div>
          <label class="label">When are you most productive during the day?</label>
          <textarea id="suggest-time" class="input resize-none" rows="3" placeholder="e.g. Early morning, late evenings..." autofocus></textarea>
        </div>
        <div class="flex justify-between gap-2">
          <button class="btn-ghost" data-suggest-back="0">Back</button>
          <button class="btn-primary" data-suggest-next="2">Next</button>
        </div>
      </div>

      <div data-suggest-step="2" class="space-y-4 hidden">
        <div>
          <label class="label">What habits have you struggled with?</label>
          <textarea id="suggest-struggles" class="input resize-none" rows="3" placeholder="e.g. Gym in the morning, journaling at night..." autofocus></textarea>
        </div>
        <div class="flex justify-between gap-2">
          <button class="btn-ghost" data-suggest-back="1">Back</button>
          <button id="suggest-submit-btn" class="btn-primary">
            <i data-lucide="sparkles" class="w-[14px] h-[14px]"></i>
            Get suggestions
          </button>
        </div>
      </div>

      <div data-suggest-step="3" class="space-y-3 hidden">
        <div id="suggest-results"></div>
        <div class="flex justify-end">
          <button class="btn-secondary" data-suggest-cancel>Done</button>
        </div>
      </div>

    </div>
  </div>
</div>
