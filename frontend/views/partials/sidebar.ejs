<aside class="hidden md:flex md:flex-col w-64 fixed inset-y-0 left-0 z-30 glass border-r">
  <div class="px-6 py-5 border-b divider">
    <div class="flex items-center gap-2">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-brand-500 to-brand-700 text-white flex items-center justify-center shadow-lg shadow-brand-500/30">
        <i data-lucide="sparkles" class="w-[18px] h-[18px]"></i>
      </div>
      <div class="font-semibold text-lg tracking-tight">AI Habit Tracker</div>
    </div>
  </div>

  <nav class="flex-1 px-3 py-4 space-y-1">
    <a href="/dashboard" data-nav-link="/dashboard" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition text-soft hover:bg-[var(--surface-hover)]">
      <i data-lucide="layout-dashboard" class="w-[18px] h-[18px]"></i> Dashboard
    </a>
    <a href="/habits" data-nav-link="/habits" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition text-soft hover:bg-[var(--surface-hover)]">
      <i data-lucide="list-checks" class="w-[18px] h-[18px]"></i> Habits
    </a>
    <a href="/weekly" data-nav-link="/weekly" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition text-soft hover:bg-[var(--surface-hover)]">
      <i data-lucide="calendar-days" class="w-[18px] h-[18px]"></i> Weekly
    </a>
    <a href="/insights" data-nav-link="/insights" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition text-soft hover:bg-[var(--surface-hover)]">
      <i data-lucide="brain" class="w-[18px] h-[18px]"></i> Insights
    </a>
    <a href="/stats" data-nav-link="/stats" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition text-soft hover:bg-[var(--surface-hover)]">
      <i data-lucide="bar-chart-3" class="w-[18px] h-[18px]"></i> Statistics
    </a>
  </nav>

  <div class="p-3 border-t divider space-y-1">
    <button data-theme-toggle class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm text-soft hover:bg-[var(--surface-hover)] transition">
      <i data-theme-icon data-lucide="moon" class="w-[18px] h-[18px]"></i>
      <span data-theme-label>Dark mode</span>
    </button>

    <button id="sidebar-settings-btn" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm text-soft hover:bg-[var(--surface-hover)] transition">
      <i data-lucide="settings" class="w-[18px] h-[18px]"></i> Settings
    </button>

    <div class="px-2 py-2 flex items-center gap-3">
      <div class="w-9 h-9 rounded-full bg-gradient-to-br from-brand-500 to-brand-700 text-white font-semibold flex items-center justify-center shadow-md shadow-brand-500/30">
        <span data-user-avatar>U</span>
      </div>
      <div class="flex-1 min-w-0">
        <div class="text-sm font-medium truncate" data-user-name></div>
        <div class="text-xs text-faint truncate" data-user-email></div>
      </div>
      <button id="sidebar-logout-btn" title="Log out" class="p-2 rounded-lg text-soft hover:bg-[var(--surface-hover)]">
        <i data-lucide="log-out" class="w-4 h-4"></i>
      </button>
    </div>
  </div>
</aside>

<%- include("settings-modal") %>

<script src="/js/sidebar.js"></script>
