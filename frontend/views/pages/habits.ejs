<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("../partials/head", { title: "All habits · AI Habit Tracker" }) %>
</head>
<body>
  <%- include("../partials/sidebar") %>

  <div class="md:pl-64">
    <%- include("../partials/mobilenav") %>

    <main class="max-w-5xl mx-auto px-4 md:px-8 py-6 md:py-8 pb-24 md:pb-8">
      <div id="habits-loading" class="flex items-center justify-center min-h-[60vh]">
        <div class="animate-spin rounded-full border-2 border-ink-200 border-t-brand-600" style="width:24px;height:24px;"></div>
      </div>

      <div id="habits-content" class="space-y-6 animate-fade-in hidden">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
          <div>
            <h1 class="text-2xl md:text-3xl font-semibold tracking-tight">All habits</h1>
            <p class="text-sm text-muted mt-0.5">Manage every habit you've ever created.</p>
          </div>
          <div class="flex items-center gap-2">
            <button id="suggest-habit-btn" class="btn-secondary">
              <i data-lucide="sparkles" class="w-[14px] h-[14px]"></i>
              <span class="hidden sm:inline">Suggest</span>
            </button>
            <button id="new-habit-btn" class="btn-primary">
              <i data-lucide="plus" class="w-[14px] h-[14px]"></i>
              New habit
            </button>
          </div>
        </div>

        <div class="card p-4">
          <div class="flex flex-col md:flex-row gap-3 md:items-center">
            <div class="relative flex-1">
              <i data-lucide="search" class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-faint pointer-events-none"></i>
              <input id="habits-search" class="input pl-9" placeholder="Search habits..." />
            </div>
            <select id="habits-category-filter" class="input md:w-52">
              <option value="All">All categories</option>
            </select>
            <div class="inline-flex rounded-xl glass overflow-hidden text-sm">
              <button id="habits-tab-active" class="px-3.5 py-2.5 font-medium transition bg-brand-500/15 text-brand-700 dark:text-brand-300">
                Active · <span id="habits-active-count">0</span>
              </button>
              <button id="habits-tab-archived" class="px-3.5 py-2.5 font-medium transition border-l divider text-soft hover:bg-[var(--surface-hover)]">
                Archived · <span id="habits-archived-count">0</span>
              </button>
            </div>
          </div>
        </div>

        <div id="habits-empty" class="card p-10 text-center hidden">
          <div class="text-5xl mb-3" id="habits-empty-icon">🎯</div>
          <div class="font-medium" id="habits-empty-title">No habits yet</div>
          <div class="text-sm text-muted mt-1" id="habits-empty-desc">Start small — something you can do in under 5 minutes.</div>
          <button id="habits-empty-create-btn" class="btn-primary mt-4 hidden">
            <i data-lucide="plus" class="w-[14px] h-[14px]"></i>
            Create habit
          </button>
        </div>

        <div id="habits-list" class="space-y-2"></div>
      </div>
    </main>
  </div>

  <%- include("../partials/habit-modal") %>
  <%- include("../partials/suggestion-modal") %>

  <%- include("../partials/scripts-app") %>
  <script src="/js/habit-form.js"></script>
  <script src="/js/suggestion-modal.js"></script>
  <script src="/js/pages/habits.js"></script>
</body>
</html>
