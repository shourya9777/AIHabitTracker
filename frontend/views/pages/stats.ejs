<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("../partials/head", { title: "Statistics · AI Habit Tracker" }) %>
</head>
<body>
  <%- include("../partials/sidebar") %>

  <div class="md:pl-64">
    <%- include("../partials/mobilenav") %>

    <main class="max-w-5xl mx-auto px-4 md:px-8 py-6 md:py-8 pb-24 md:pb-8">
      <div id="stats-loading" class="flex items-center justify-center min-h-[60vh]">
        <div class="animate-spin rounded-full border-2 border-ink-200 border-t-brand-600" style="width:24px;height:24px;"></div>
      </div>

      <div id="stats-content" class="space-y-6 animate-fade-in hidden">
        <div>
          <h1 class="text-2xl md:text-3xl font-semibold tracking-tight">Statistics</h1>
          <p class="text-sm text-muted mt-0.5">Deep insights from your habit data.</p>
        </div>

        <div id="stats-empty" class="card p-10 text-center hidden">
          <div class="text-5xl mb-3">📊</div>
          <div class="font-medium">No data yet</div>
          <div class="text-sm text-muted mt-1">Create a habit and check it off a few times to unlock statistics.</div>
        </div>

        <div id="stats-body" class="space-y-6 hidden">
          <div class="grid md:grid-cols-3 gap-4" id="stats-highlight-cards"></div>

          <div class="grid lg:grid-cols-2 gap-5">
            <div class="card p-5">
              <div class="text-sm font-medium mb-3">Completions — last 7 days</div>
              <div id="stats-weekly-chart"></div>
            </div>
            <div class="card p-5">
              <div class="text-sm font-medium mb-3">Last 30 days</div>
              <div id="stats-monthly-chart"></div>
            </div>
          </div>

          <div class="grid lg:grid-cols-[1fr_1fr] gap-5">
            <div class="card p-5">
              <div class="text-sm font-medium mb-3">Completions by category</div>
              <div id="stats-category-chart"></div>
            </div>
            <div class="card p-5">
              <div class="text-sm font-medium mb-3">Top habits by completion (30d)</div>
              <div id="stats-top-habits"></div>
            </div>
          </div>

          <div class="space-y-2">
            <div class="text-sm font-medium">All habits</div>
            <div id="stats-habit-cards" class="space-y-2"></div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <%- include("../partials/ai-chat") %>

  <%- include("../partials/scripts-app") %>
  <script src="/js/charts.js"></script>
  <script src="/js/ai-chat.js"></script>
  <script src="/js/pages/stats.js"></script>
</body>
</html>
