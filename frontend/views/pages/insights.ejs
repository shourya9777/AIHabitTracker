<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("../partials/head", { title: "Weekly insights · AI Habit Tracker" }) %>
</head>
<body>
  <%- include("../partials/sidebar") %>

  <div class="md:pl-64">
    <%- include("../partials/mobilenav") %>

    <main class="max-w-5xl mx-auto px-4 md:px-8 py-6 md:py-8 pb-24 md:pb-8">
      <div id="insights-loading" class="flex items-center justify-center min-h-[60vh]">
        <div class="animate-spin rounded-full border-2 border-ink-200 border-t-brand-600" style="width:24px;height:24px;"></div>
      </div>

      <div id="insights-content" class="space-y-6 animate-fade-in hidden">
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3">
          <div>
            <h1 class="text-2xl md:text-3xl font-semibold tracking-tight">Weekly insights</h1>
            <p class="text-sm text-muted mt-0.5 inline-flex items-center gap-2">
              <i data-lucide="calendar-range" class="w-[14px] h-[14px]"></i>
              <span id="insights-week-range">—</span>
            </p>
          </div>
          <button id="insights-regenerate-btn" class="btn-secondary">
            <i data-lucide="refresh-cw" class="w-[14px] h-[14px]"></i>
            Regenerate report
          </button>
        </div>

        <div class="card p-6 relative overflow-hidden">
          <div class="absolute inset-0 pointer-events-none opacity-50" style="background: radial-gradient(circle at 0% 0%, rgba(251,191,36,0.22), transparent 55%), radial-gradient(circle at 100% 100%, rgba(236,72,153,0.12), transparent 55%);"></div>
          <div class="relative">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-400 to-brand-600 text-white flex items-center justify-center shadow-lg shadow-brand-500/30">
                <i data-lucide="sparkles" class="w-[18px] h-[18px]"></i>
              </div>
              <div class="flex-1">
                <div class="text-sm font-semibold">AI Weekly Report</div>
                <div class="text-xs text-muted" id="insights-report-subtitle">Personalised review of your last 7 days</div>
              </div>
            </div>
            <div id="insights-report-loading" class="hidden flex items-center gap-2 text-sm text-soft py-6">
              <i data-lucide="refresh-cw" class="w-[14px] h-[14px] animate-spin"></i>
              Analysing your week...
            </div>
            <div id="insights-report-body" class="glass rounded-xl p-4 text-sm hidden"></div>
            <button id="insights-generate-btn" class="btn-primary hidden">
              <i data-lucide="sparkles" class="w-[14px] h-[14px]"></i> Generate report
            </button>
          </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
          <div class="card p-4">
            <div class="flex items-center gap-2 text-xs font-medium text-muted"><i data-lucide="activity" class="w-[14px] h-[14px]"></i> Completions</div>
            <div class="mt-1 flex items-baseline gap-2">
              <div class="text-2xl font-semibold" id="insights-total-done">0</div>
              <span id="insights-delta-pill" class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium"></span>
            </div>
            <div class="text-xs text-muted mt-0.5">vs last week</div>
          </div>
          <div class="card p-4">
            <div class="flex items-center gap-2 text-xs font-medium text-muted"><i data-lucide="trending-up" class="w-[14px] h-[14px]"></i> Completion rate</div>
            <div class="text-2xl font-semibold mt-1" id="insights-completion-rate">0%</div>
            <div class="text-xs text-muted mt-0.5" id="insights-completion-sub">0/0 slots</div>
          </div>
          <div class="card p-4">
            <div class="flex items-center gap-2 text-xs font-medium text-muted"><i data-lucide="calendar-range" class="w-[14px] h-[14px]"></i> Best day</div>
            <div class="text-2xl font-semibold mt-1" id="insights-best-day">—</div>
            <div class="text-xs text-muted mt-0.5" id="insights-best-day-sub">no data</div>
          </div>
          <div class="card p-4">
            <div class="flex items-center gap-2 text-xs font-medium text-muted"><i data-lucide="trophy" class="w-[14px] h-[14px]"></i> Top habit</div>
            <div class="mt-1 truncate flex items-center gap-1.5" id="insights-top-habit">—</div>
            <div class="text-xs text-muted mt-0.5" id="insights-top-habit-sub">no completions</div>
          </div>
        </div>

        <div class="grid lg:grid-cols-2 gap-5">
          <div class="card p-5">
            <div class="text-sm font-medium mb-3">Completions by day</div>
            <div id="insights-daily-chart"></div>
          </div>
          <div class="card p-5">
            <div class="text-sm font-medium mb-3">This week vs last week</div>
            <div id="insights-compare-chart"></div>
          </div>
        </div>

        <div class="grid lg:grid-cols-[1fr_1.4fr] gap-5">
          <div class="card p-5">
            <div class="text-sm font-medium mb-3">By category</div>
            <div id="insights-category-chart"></div>
          </div>
          <div class="card p-5">
            <div class="flex items-center justify-between mb-3">
              <div class="text-sm font-medium">Habit performance</div>
              <div class="text-xs text-muted">vs target this week</div>
            </div>
            <div id="insights-per-habit"></div>
          </div>
        </div>

        <div id="insights-streaks-card" class="card p-5 hidden">
          <div class="flex items-center justify-between mb-3">
            <div class="text-sm font-medium">Active streaks</div>
            <div class="text-xs text-muted" id="insights-streaks-sub">0 of 0</div>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2" id="insights-streaks-grid"></div>
        </div>
      </div>
    </main>
  </div>

  <%- include("../partials/scripts-app") %>
  <script src="/js/charts.js"></script>
  <script src="/js/pages/insights.js"></script>
</body>
</html>
